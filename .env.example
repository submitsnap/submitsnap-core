# Copy this file to .env. Never commit a real JWT secret or provider token.
DATABASE_URL=postgres://postgres:postgres@localhost:5499/submitsnap
REDIS_URL=redis://127.0.0.1:6399
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_ISSUER=submitsnap
JWT_AUDIENCE=submitsnap-api
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
DATABASE_MAX_CONNECTIONS=10

# Request budgets, counted per client IP. Sign-in endpoints are tighter than the global
# default because they are the primary target for credential stuffing.
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10
REGISTER_RATE_LIMIT_PER_HOUR=5
# Covers password reset and email verification, which send mail and consume single-use tokens.
SENSITIVE_RATE_LIMIT_PER_HOUR=5

# Access tokens are short-lived; refresh tokens are rotated on every use and are the only
# credential that can be revoked server-side.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600
# When true, accounts are created pending and cannot sign in until the address is confirmed.
REQUIRE_EMAIL_VERIFICATION=false

# Failed attempts before an account is locked, and how long the lock holds.
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_SECONDS=900

# Optional extra secret mixed into every password hash. Rotating it invalidates all existing
# passwords, so set it once at deployment time and treat it like any other secret.
# PASSWORD_PEPPER=

# Set true in production HTTPS deployments. Enables the Secure cookie flag and HSTS.
COOKIE_SECURE=false

# Comma-separated browser origins allowed to call the API with credentials.
# Leave unset to disable CORS entirely (correct for a same-origin deployment).
# CORS_ALLOWED_ORIGINS=https://app.example.com

REQUEST_BODY_LIMIT_BYTES=65536
REQUEST_TIMEOUT_SECONDS=15

# Base URL of the web application, used to build the links inside outgoing emails.
APP_BASE_URL=http://localhost:3000

# Serve the OpenAPI document and Swagger UI at /docs. Disable this in production if the API
# is not meant to be publicly documented.
API_DOCS_ENABLED=true

# Choose one: disabled, smtp, resend, postmark
EMAIL_PROVIDER=disabled
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=hello@example.com
EMAIL_API_TOKEN=
# Useful for local testing of an HTTP provider.
# EMAIL_API_BASE_URL=http://127.0.0.1:9000
